# === Jarvis — variables de entorno (plantilla) ===
# Copia este fichero a .env y rellena los valores.
# NUNCA commitees el fichero .env (está en .gitignore).

# Token OAuth de larga duración generado con:  claude setup-token
# Autentica el Agent SDK contra tu SUSCRIPCIÓN de Claude (no contra API key).
CLAUDE_CODE_OAUTH_TOKEN=

# ⚠️ NO definir ANTHROPIC_API_KEY aquí ni en el entorno del servicio.
# Si está presente, el Agent SDK factura pay-as-you-go e IGNORA la suscripción.
# Se deja deliberadamente ausente.
# ANTHROPIC_API_KEY=

# Capacidades a cargar, separadas por comas. Vacía o "all" = todas:
#   media, youtube, spotify, notify, reminders, homeassistant, workspace
# Además, cada una se apaga sola si falta su configuración (p. ej. notify y
# reminders sin NTFY_TOPIC). youtube necesita media. Detalle: README §Capabilities.
# JARVIS_CAPABILITIES=all

# Bind de la API del núcleo. Opcionales: por defecto 127.0.0.1:8200 en dev; en
# Docker el host es 0.0.0.0 y JARVIS_PORT (si lo defines) cambia el puerto.
# JARVIS_HOST=0.0.0.0
# JARVIS_PORT=8200

# Zona horaria del contenedor (Docker). Por defecto Europe/Madrid.
# TZ=Europe/Madrid

# Modelo Whisper del STT en Docker (por defecto medium). tiny/base/small gastan
# menos RAM y CPU; large-v3 / large-v3-turbo más (y piden subir JARVIS_MEM_LIMIT).
# JARVIS_STT_MODEL=medium

# Tope de RAM del contenedor jarvis (Docker, sin swap). 4g cubre medium (~2 GB
# con el modelo cargado + ~0,35 GB por sesión abierta) con margen; súbelo si usas
# un modelo Whisper mayor.
# JARVIS_MEM_LIMIT=4g

# Precarga del modelo de voz al arrancar (1 = sí). Pon 0 si solo usas texto:
# ahorra ~2 GB de RAM y Whisper se cargará solo si alguien abre la voz.
# JARVIS_STT_PRELOAD=1

# Nombre con el que Jarvis se dirige a ti (se inserta en su system prompt).
JARVIS_USER_NAME=Tony

# === Capacidad: notificaciones push (ntfy) ===
# Servidor ntfy (propio o https://ntfy.sh) y topic donde Jarvis publica los avisos.
# Necesario para notificaciones y recordatorios; vacío = sin avisos al móvil.
# Con un servidor público, usa un topic no adivinable (p. ej. jarvis-<aleatorio>). Si tu servidor es deny-all,
# la autenticación es por TOKEN: créalo con  ntfy token add --label jarvis <usuario>
NTFY_BASE_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# === Capacidad: recordatorios/temporizadores ===
# Ruta de la BD SQLite del scheduler. En Docker apunta al volumen persistente
# (jarvis-data). En dev, si se omite, cae a <proyecto>/data/reminders.sqlite.
# JARVIS_REMINDERS_DB=/app/data/reminders.sqlite

# === Capacidad: Spotify (Spotify Connect) ===
# Requiere una app en https://developer.spotify.com (cuenta Premium para controlar).
# El redirect URI debe estar dado de alta en la app (http://127.0.0.1:8888/callback).
# La autorización inicial se hace una vez con: python -m scripts.spotify_auth
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Ruta del token cacheado. En Docker, volumen persistente; en dev cae a
# <proyecto>/data/spotify-cache si se omite.
# SPOTIFY_CACHE=/app/data/spotify-cache

# === Capacidad: domótica (Home Assistant) ===
# Jarvis consume el servidor MCP de HA (SSE) por LAN interna (sin Authelia).
# HA_URL = endpoint MCP SSE de HA. HA_TOKEN = long-lived access token generado
# en HA (perfil de usuario → Tokens de larga duración). Si HA_TOKEN está vacío,
# la capacidad se omite (útil en dev sin HA a mano).
HA_URL=http://192.168.1.10:8123/mcp_server/sse
HA_TOKEN=

# === Capacidad: workspace (estado de proyectos y notas por voz) ===
# Carpeta con tus proyectos, montada en solo lectura (ver
# docker-compose.override.example.yml). Sin ella la capacidad se omite.
# JARVIS_WORKSPACE=/workspace
# Carpeta con los bare repos (<proyecto>.git) para "¿qué se ha hecho últimamente?".
# JARVIS_GIT_ROOT=/opt/git
# Repo git donde Jarvis apunta notas (sección Inbox de JARVIS_NOTES_FILE) con
# commit + push automáticos. Sin él, la capacidad es solo de lectura.
# JARVIS_NOTES_REMOTE=/opt/git/notes.git
# JARVIS_NOTES_DIR=/app/data/notes
# JARVIS_NOTES_FILE=TODO.md

# === Capacidad: agentes en segundo plano (worker, perfil "agents") ===
# Arranque: docker compose --profile agents up -d --build jarvis-worker
# El núcleo habla con el worker por HTTP local. Sin JARVIS_AGENTS_URL la
# capacidad se omite. El token es un secreto compartido núcleo↔worker
# (genera uno: python -c "import secrets; print(secrets.token_hex(24))").
# JARVIS_AGENTS_URL=http://127.0.0.1:8113
# JARVIS_WORKER_TOKEN=
# Repos (bare) que los agentes pueden usar, separados por comas; móntalos en
# /repos/<repo>.git desde docker-compose.override.yml.
# JARVIS_AGENT_REPOS=mi-repo
# Agentes trabajando a la vez y modelo.
# JARVIS_AGENTS_MAX=2
# JARVIS_AGENT_MODEL=claude-sonnet-4-6
# Reglas comunes de los agentes (opcional): bare repo con agents/CLAUDE.md (+ rules/
# por tipo de fichero), montado en /config.git desde docker-compose.override.yml.
# JARVIS_AGENT_CONFIG_REPO=/config.git
# Ciclo de un agente terminado (idle), en segundos, dentro de la hora que dura
# la caché de prompt: aviso, ritual de cierre (documenta cómo retomar) y cierre
# de la sesión (se puede retomar después en una sesión nueva).
# JARVIS_AGENT_IDLE_WARN=2100
# JARVIS_AGENT_HANDOFF_AT=2700
# JARVIS_AGENT_IDLE_TTL=3300
# Tope de trabajo por turno, y espera al gestor antes de pasar una pregunta al usuario
# (red de seguridad: con Vision activo, el gestor responde o escala él mismo).
# JARVIS_AGENT_TURN_TIMEOUT=1800
# JARVIS_AGENT_MANAGER_TIMEOUT=900
# 1 = también las preguntas de diseño van primero al gestor (Vision decide si son
# tuyas). Con JARVIS_VISION=0, ponlo a 0 para que no esperen al temporizador.
# JARVIS_AGENT_ASK_MANAGER_FIRST=1
# Salvaguarda de uso (%): con la ventana de 5 h (LIMIT) o la semanal (LIMIT_7D) a
# este nivel o más (contando también tu propio uso de Claude), no se lanzan agentes
# ni empiezan turnos nuevos: cada agente guarda su trabajo (handoff) y queda en pausa.
# JARVIS_AGENT_USAGE_LIMIT=60
# JARVIS_AGENT_USAGE_LIMIT_7D=75
# Sonda del uso real: 1 token de Haiku con CLAUDE_CODE_OAUTH_TOKEN cada N s mientras
# haya agentes (y antes de lanzar uno). Si no puede leer el uso, no se lanza nada.
# JARVIS_USAGE_PROBE=1
# JARVIS_USAGE_PROBE_EVERY=120
# Punto de control (%): cada vez que la ventana de 5 h sube esto durante un turno, el
# agente se interrumpe (sin perder la sesión), resume y estima lo que falta; si es
# mucho, pide a Vision que le recorte el alcance. 0 = apagado.
# JARVIS_AGENT_CHECKPOINT=5
# Qué pasa con los pausados: session = esperan a que digas "retoma" (por defecto);
# autonomous = se retoman solos al reiniciarse la ventana (ojo: la semanal tarda días).
# JARVIS_AGENT_USAGE_MODE=session
# Vision, el gestor autónomo (Opus): responde o te pasa las preguntas de los agentes
# sin que hables con Jarvis. Activa por defecto si hay worker; 0 la apaga. Lee los
# planes desde los bare repos de JARVIS_GIT_ROOT (rama develop si existe).
# Ciclo (s): handoff a los 45 min inactiva; si no hay agentes en marcha, cierre a
# los 50; con contexto por encima de MAX_CONTEXT tokens, se recicla tras el handoff.
# Rama de integración: el trabajo autónomo va aquí (nunca a la principal); Jarvis la
# crea y la pone al día con la principal al lanzar un agente de código, y Vision
# fusiona en ella. Tú apruebas al final un PR develop → principal. Vacía = desactivada.
# JARVIS_INTEGRATION_BRANCH=develop
# JARVIS_VISION=1
# JARVIS_VISION_MODEL=
# JARVIS_VISION_HANDOFF_AFTER=2700
# JARVIS_VISION_DIE_AFTER=3000
# JARVIS_VISION_MAX_CONTEXT=100000
# JARVIS_VISION_DATA=/app/data/vision
# Tras fusionar, Vision lanza el siguiente punto del plan (un agente por punto); 0 = no lanza.
# JARVIS_VISION_LAUNCH=1
# TTL de la conversación que gestiona agentes mientras queden vivos (voz web).
# JARVIS_AGENTS_SESSION_TIMEOUT_SECONDS=3600
# JARVIS_WORKER_MEM_LIMIT=4g
